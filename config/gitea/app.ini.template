; Template of config/gitea/app.ini, which is gitignored. install.sh and the admin (init, start) copy it there when
; it is missing. Only what differs from Gitea's defaults is listed here.
;
; Set elsewhere:
; - the domain values (ROOT_URL, DOMAIN, SSH_DOMAIN) and the webhook host list: GITEA__* in gitea.yaml, written into
;   app.ini at every start;
; - INTERNAL_TOKEN and JWT_SECRET: generated by Gitea on its first start and written into app.ini, so every
;   installation has its own. Never put secrets here.

APP_NAME = Gitea
RUN_MODE = prod
RUN_USER = git
; Keeps everything on the container's /data volume (the docker image's layout)
WORK_PATH = /data/gitea

[server]
APP_DATA_PATH = /data/gitea
HTTP_PORT = 3000

[database]
; The gitea-db service in gitea.yaml (internal network only)
DB_TYPE = mysql
HOST = gitea-db:3306
NAME = gitea
USER = gitea
PASSWD = gitea

[security]
; Skips the web installer
INSTALL_LOCK = true
; Traefik is the single proxy in front
REVERSE_PROXY_LIMIT = 1
REVERSE_PROXY_TRUSTED_PROXIES = *

[service]
; Accounts are created by init / the admin UI only, and nothing is visible without signing in
DISABLE_REGISTRATION = true
REQUIRE_SIGNIN_VIEW = true

[session]
; The default (memory) would log everyone out on every restart
PROVIDER = file

[openid]
ENABLE_OPENID_SIGNIN = false
ENABLE_OPENID_SIGNUP = false

[repository]
ROOT = /data/git/repositories
; Competitors must not see each other's work
FORCE_PRIVATE = true
DEFAULT_REPO_UNITS = repo.code,repo.actions

[lfs]
PATH = /data/git/lfs

[cron.update_checker]
ENABLED = false
